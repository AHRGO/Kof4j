// dev/kof/workflow-host.kf — host escrito EM KOF do pacote virtual
// `kof.workflow` (tracker 2.1, plano §5). MVP (Q2 da enquete 19/09):
// job/dag/after/run/Report + faces do bundle 2.1.3 (aditivas): retry
// (dag.retry/retryFixed/exponential, 7db91735), deadLetter (duas faces do
// Q4: `Report.dead` in-memory SEMPRE + sink durável opt-in por job) e
// schedule(expr, dag) que DELEGA a scheduler.at (contrato §3: workflow não
// re-implementa cron — no Native a recusa CRON001 sobe honesta no call-site).
// checkpoint: face 2.1.3a (workflow-ckpt-host.kf); supervisor one_for_one:
// face 2.1.3b runSupervised (workflow-sup-host.kf — delega ao kof.supervisor,
// nunca restart próprio).
// Injetado flat por CompilerWorkflow no `import kof.workflow`
// explícito (mesmo mecanismo do kof.supervisor, DD-OTP-01 opção A).
//
// Execução sequencial e determinística (sem threads, sem await): funciona em
// TODO target (JVM/ANDROID/Script/JS/Native) — nada aqui cruza fronteira de
// runtime. A falha de um job pula transitivamente seus dependentes; ciclo é
// rejeitado em run() com mensagem acionável (invariante do plano §2).

Bool kofWfTem(List<String> nomes, String x) {
    var i = 0
    while (i < nomes.size) {
        if (nomes.get(i) == x) { return true }
        i = i + 1
    }
    return false
}

String kofWfJoin(List<String> xs, String sep) {
    var out = ""
    var i = 0
    while (i < xs.size) {
        if (i > 0) { out = out + sep }
        out = out + xs.get(i)
        i = i + 1
    }
    return out
}

Bool kofWfTemJob(List<KofWfJob> xs, String nome) {
    var i = 0
    while (i < xs.size) {
        if (xs.get(i).nome == nome) { return true }
        i = i + 1
    }
    return false
}

// coleta o alvo + TODAS as dependências transitivas (worklist iterativa,
// sem recursão) — base do `runJob` do runner (D-WORKFLOW-RUN).
void kofWfColetar(KofWfJob alvo, List<KofWfJob> out) {
    var pend = listOf()
    pend.add(alvo)
    while (pend.size > 0) {
        var cur = pend.get(pend.size - 1)
        pend.remove(pend.size - 1)
        if (!kofWfTemJob(out, cur.nome)) {
            out.add(cur)
            var i = 0
            while (i < cur.deps.size) {
                pend.add(cur.deps.get(i))
                i = i + 1
            }
        }
    }
}

class KofWfJob {
    // NUNCA tirar os inicializadores daqui: `String nome` sem `= null` na
    // linha de cima de um campo-lambda confunde o lookahead do parser
    // ("Unexpected token in class body", medido 19/09 — gramática é regra 6).
    String nome = null
    () -> Bool corpo = null
    List<KofWfJob> deps = listOf()
    KofWfRetry retryCfg = null
    (String, String) -> Bool deadSink = null

    public constructor(String nome, () -> Bool corpo) {
        if (nome == "") { throw "workflow: job com nome vazio" }
        if (corpo == null) { throw "workflow '" + nome + "': corpo nulo" }
        this.nome = nome
        this.corpo = corpo
    }

    KofWfJob after(KofWfJob dep) {
        if (dep == null) { throw "workflow '" + nome + "': after() com dependência nula" }
        if (dep.nome == nome) { throw "workflow '" + nome + "': dependência de si mesmo" }
        deps.add(dep)
        return this
    }
}

// face 1/N do bundle 2.1.3 (Q3: helper ADITIVO do próprio workflow): config
// pendurada no job pelo dag; o laço de tentativa mora em run().
class KofWfRetry {
    Int times = 0
    (Int) -> Int backoff = (n: Int) -> 0
}

(Int) -> Int exponential(Int baseMs, Int factor) {
    if (baseMs < 0) { throw "workflow: exponential() com base negativa" }
    if (factor < 1) { throw "workflow: exponential() com fator < 1" }
    return (n: Int) -> {
        var v = baseMs
        var i = 1
        while (i < n) {
            v = v * factor
            i = i + 1
        }
        return v
    }
}

class KofWfReport {
    List<String> succeeded
    List<String> failed
    List<String> skipped
    List<String> errors
    List<String> retries   // "nome: tentativas=N" p/ jobs que retryaram (face 2.1.3)
    List<String> dead      // "nome: motivo" p/ todo job que esgotou retry (face deadLetter, sempre presente)

    public constructor() {
        succeeded = listOf()
        failed = listOf()
        skipped = listOf()
        errors = listOf()
        retries = listOf()
        dead = listOf()
    }

    Bool allOk() {
        return failed.size == 0 && skipped.size == 0
    }

    String summary() {
        return "ok=" + kofWfJoin(succeeded, ",") +
               " failed=" + kofWfJoin(failed, ",") +
               " skipped=" + kofWfJoin(skipped, ",")
    }
}

class KofWfDag {
    List<KofWfJob> jobs
    String dagNome = null
    // ⚠️ PARSE023 medido 19/09: função-tipo em CAMPO logo após um campo
    // `List<...>` não parseia ("Expected parameter name") — os campos-lambda
    // seguem um campo tipado simples (mesmo padrão do deadSink em KofWfJob,
    // que segue `KofWfRetry retryCfg = null`). Hooks levam (dagName,
    // jobName): a forma de 1 param em campo é o próprio quirk (PARSE023).
    (String, String) -> Bool ckLoad = null
    (String, String) -> Bool ckSave = null

    public constructor(List<KofWfJob> jobs) {
        if (jobs == null) { throw "workflow: dag() sem jobs" }
        if (jobs.size == 0) { throw "workflow: dag() vazia" }
        this.jobs = listOf()
        var i = 0
        while (i < jobs.size) {
            var j = jobs.get(i)
            if (j == null) { throw "workflow: dag() com job nulo" }
            var k = 0
            while (k < this.jobs.size) {
                if (this.jobs.get(k).nome == j.nome) {
                    throw "workflow: nome de job duplicado '" + j.nome + "'"
                }
                k = k + 1
            }
            this.jobs.add(j)
            i = i + 1
        }
    }

    // Q3 (enquete 19/09): retry ADITIVO do workflow — `flow.retry(job, 3,
    // exponential(1000, 2.0))` na forma do sketch §2 (flat); `retryFixed` é a
    // versão imediata. A migração do retry do kof.http sobre este helper é
    // fatia assinada SEPARADA depois (regra 8) — nada aqui toca kof.http.
    KofWfDag retry(KofWfJob j, Int times, (Int) -> Int backoff) {
        if (j == null) { throw "workflow: retry() com job nulo" }
        if (times < 1) { throw "workflow '" + j.nome + "': retry() com times < 1" }
        var alvo = kofWfProcurar(j)
        var cfg = KofWfRetry()
        cfg.times = times
        cfg.backoff = backoff
        alvo.retryCfg = cfg
        return this
    }

    KofWfDag retryFixed(KofWfJob j, Int times) {
        return retry(j, times, (n: Int) -> 0)
    }

    // face durável do deadLetter (Q4, opt-in): `flow.deadLetter(job, sink)` —
    // o sink `(nome, motivo) -> Bool` é CÓDIGO DO USUÁRIO (persiste onde
    // quiser, ex. kof.orm no corpo dele); o workflow continua puro e
    // target-neutro (nunca depende do kof.orm aqui — ORM001 só alcança quem
    // usa, R6/R7). `false` ou throw no sink falha ALTO com o nome do job.
    KofWfDag deadLetter(KofWfJob j, (String, String) -> Bool sink) {
        if (j == null) { throw "workflow: deadLetter() com job nulo" }
        if (sink == null) { throw "workflow '" + j.nome + "': deadLetter() com sink nulo" }
        var alvo = kofWfProcurar(j)
        if (alvo.deadSink != null) {
            throw "workflow '" + j.nome + "': deadLetter já registrado para este job"
        }
        alvo.deadSink = sink
        return this
    }

    KofWfJob kofWfProcurar(KofWfJob j) {
        var i = 0
        while (i < jobs.size) {
            if (jobs.get(i).nome == j.nome) { return jobs.get(i) }
            i = i + 1
        }
        throw "workflow: retry() em '" + j.nome + "' — job não está na dag"
    }

    KofWfJob kofWfProcurarNome(String nome) {
        var i = 0
        while (i < jobs.size) {
            if (jobs.get(i).nome == nome) { return jobs.get(i) }
            i = i + 1
        }
        throw "workflow: job '" + nome + "' não existe na dag"
    }

    // introspecção (D-WORKFLOW-RUN): nomes na ordem de declaração e as
    // dependências diretas de um job — o runner monta o DAG a partir daqui.
    List<String> jobNames() {
        var out = listOf()
        var i = 0
        while (i < jobs.size) { out.add(jobs.get(i).nome); i = i + 1 }
        return out
    }

    List<String> depsOf(String nome) {
        var j = kofWfProcurarNome(nome)
        var out = listOf()
        var i = 0
        while (i < j.deps.size) { out.add(j.deps.get(i).nome); i = i + 1 }
        return out
    }

    // ordem topológica SEM executar corpo (--dry-run): mesmo fixpoint do
    // run(), mas só resolve a ordem; ciclo sobe com a MESMA mensagem do run().
    List<String> order() {
        var out = listOf()
        var rest = listOf()
        var i = 0
        while (i < jobs.size) { rest.add(jobs.get(i)); i = i + 1 }
        var done = listOf()
        while (rest.size > 0) {
            var progressed = false
            var keep = listOf()
            var j = 0
            while (j < rest.size) {
                var job = rest.get(j)
                var ready = true
                var d = 0
                while (d < job.deps.size) {
                    if (!kofWfTem(done, job.deps.get(d).nome)) { ready = false }
                    d = d + 1
                }
                if (ready) {
                    out.add(job.nome)
                    done.add(job.nome)
                    progressed = true
                } else {
                    keep.add(job)
                }
                j = j + 1
            }
            if (!progressed) {
                var nomes = listOf()
                var c = 0
                while (c < rest.size) { nomes.add(rest.get(c).nome); c = c + 1 }
                throw "workflow: ciclo detectado entre: " + kofWfJoin(nomes, ",")
            }
            rest = keep
        }
        return out
    }

    // roda SÓ o job nomeado + suas dependências transitivas (--job do
    // runner). Monta uma sub-dag com os MESMOS objetos de job (preserva
    // retry/deadSink por job) e os hooks de checkpoint desta dag.
    KofWfReport runJob(String nome) {
        if (nome == null || nome == "") { throw "workflow: runJob() sem nome de job" }
        var alvo = kofWfProcurarNome(nome)
        var sel = listOf()
        kofWfColetar(alvo, sel)
        var sub = KofWfDag(sel)
        sub.dagNome = dagNome
        sub.ckLoad = ckLoad
        sub.ckSave = ckSave
        return sub.run()
    }

    // checkpoint hooks (face 2.1.3, registrados pela fatia ck via
    // `checkpoint(d, db, dagName)`): o host-core NUNCA referencia kof.orm
    // (gate ORM001 é estático — derrubaria o host inteiro no Native, mesmo
    // mecanismo do CRON001 do schedule). Restaurado = succeeded (não
    // re-executa); save recusado/lançando falha ALTO (R6).
    KofWfDag ckHooks(String dagName, (String, String) -> Bool load, (String, String) -> Bool save) {
        if (dagName == null || dagName == "") { throw "workflow: checkpoint() sem nome de dag" }
        if (load == null || save == null) { throw "workflow: checkpoint() com hook nulo" }
        if (ckLoad != null || ckSave != null) { throw "workflow: checkpoint já registrado nesta dag" }
        dagNome = dagName
        ckLoad = load
        ckSave = save
        return this
    }

    // fixpoint sequencial: roda o que está pronto, pula dependentes de
    // falha/skip, e para com erro acionável se uma ronda não progride
    // (ciclo). `done` = nomes concluídos; `bad` = falhou OU foi pulado.
    KofWfReport run() {
        var rep = KofWfReport()
        var rest = listOf()
        var i = 0
        while (i < jobs.size) { rest.add(jobs.get(i)); i = i + 1 }
        var done = listOf()
        var bad = listOf()
        while (rest.size > 0) {
            var progressed = false
            var keep = listOf()
            var j = 0
            while (j < rest.size) {
                var job = rest.get(j)
                var depsOk = true
                var depsBad = false
                var d = 0
                while (d < job.deps.size) {
                    var dn = job.deps.get(d).nome
                    if (kofWfTem(bad, dn)) { depsBad = true }
                    else if (!kofWfTem(done, dn)) { depsOk = false }
                    d = d + 1
                }
                if (depsBad) {
                    rep.skipped.add(job.nome)
                    bad.add(job.nome)
                    progressed = true
                } else if (depsOk) {
                    var jaFeito = false
                    if (ckLoad != null) {
                        var lFn: (String, String) -> Bool = ckLoad
                        try {
                            jaFeito = lFn(dagNome, job.nome)
                        } catch (String ce) {
                            throw "workflow: checkpoint load falhou para '" + job.nome + "': " + ce
                        }
                    }
                    if (jaFeito) {
                        done.add(job.nome)
                        rep.succeeded.add(job.nome)
                        progressed = true
                    } else {
                        var corpoFn: () -> Bool = job.corpo
                        var ok = false
                        var erro = ""
                        var tentativa = 0
                        var maxT = 0
                        if (job.retryCfg != null) { maxT = job.retryCfg.times }
                        while (tentativa <= maxT) {
                            try {
                                ok = corpoFn()
                            } catch (String e) {
                                ok = false
                                erro = e
                            }
                            if (ok || tentativa == maxT) { break }
                            tentativa = tentativa + 1
                            erro = ""
                            if (job.retryCfg != null) {
                                var bFn: (Int) -> Int = job.retryCfg.backoff
                                time.sleep(bFn(tentativa))
                            }
                        }
                        if (tentativa > 0) { rep.retries.add(job.nome + ": tentativas=" + (tentativa + 1)) }
                        if (erro != "") { rep.errors.add(job.nome + ": " + erro) }
                        if (ok) {
                            done.add(job.nome)
                            rep.succeeded.add(job.nome)
                            if (ckSave != null) {
                                var sCk: (String, String) -> Bool = ckSave
                                var okS = false
                                try {
                                    okS = sCk(dagNome, job.nome)
                                } catch (String se) {
                                    throw "workflow: checkpoint save falhou para '" + job.nome + "': " + se
                                }
                                if (!okS) { throw "workflow: checkpoint save recusou '" + job.nome + "'" }
                            }
                        } else {
                            if (erro == "") { rep.errors.add(job.nome + ": false") }
                            bad.add(job.nome)
                            rep.failed.add(job.nome)
                            var motivo = if (erro == "") { "false" } else { erro }
                            rep.dead.add(job.nome + ": " + motivo)
                            if (job.deadSink != null) {
                                var sFn: (String, String) -> Bool = job.deadSink
                                var okD = false
                                try {
                                    okD = sFn(job.nome, motivo)
                                } catch (String de) {
                                    throw "workflow: deadLetter sink falhou para '" + job.nome + "': " + de
                                }
                                if (!okD) {
                                    throw "workflow: deadLetter sink recusou '" + job.nome + "'"
                                }
                            }
                        }
                        progressed = true
                    }
                } else {
                    keep.add(job)
                }
                j = j + 1
            }
            if (!progressed) {
                var nomes = listOf()
                var c = 0
                while (c < rest.size) { nomes.add(rest.get(c).nome); c = c + 1 }
                throw "workflow: ciclo detectado entre: " + kofWfJoin(nomes, ",")
            }
            rest = keep
        }
        return rep
    }
}

KofWfJob job(String nome, () -> Bool corpo) {
    return KofWfJob(nome, corpo)
}

KofWfDag dag(List<KofWfJob> jobs) {
    return KofWfDag(jobs)
}
