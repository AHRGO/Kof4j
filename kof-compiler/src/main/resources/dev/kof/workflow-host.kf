// dev/kof/workflow-host.kf — host escrito EM KOF do pacote virtual
// `kof.workflow` (tracker 2.1, plano §5 2.1.2). Superfície MVP (Q2 da enquete
// 19/09): SOMENTE job/dag/after/run/Report — retry/checkpoint/deadLetter são
// do bundle 2.1.3. Injetado flat por CompilerWorkflow no `import kof.workflow`
// explícito (mesmo mecanismo do kof.supervisor, DD-OTP-01 opção A).
//
// Execução sequencial e determinística (sem threads, sem await): funciona em
// TODO target (JVM/ANDROID/Script/JS/Native) — nada aqui cruza fronteira de
// runtime. A falha de um job pula transitivamente seus dependentes; ciclo é
// rejeitado em run() com mensagem acionável (invariante do plano §2).

Bool kofWfTem(List<String> nomes, String x) {
    var i = 0
    while (i < nomes.size) {
        if (nomes.get(i) == x) { return true }
        i = i + 1
    }
    return false
}

String kofWfJoin(List<String> xs, String sep) {
    var out = ""
    var i = 0
    while (i < xs.size) {
        if (i > 0) { out = out + sep }
        out = out + xs.get(i)
        i = i + 1
    }
    return out
}

class KofWfJob {
    // NUNCA tirar os inicializadores daqui: `String nome` sem `= null` na
    // linha de cima de um campo-lambda confunde o lookahead do parser
    // ("Unexpected token in class body", medido 19/09 — gramática é regra 6).
    String nome = null
    () -> Bool corpo = null
    List<KofWfJob> deps = listOf()
    KofWfRetry retryCfg = null

    public constructor(String nome, () -> Bool corpo) {
        if (nome == "") { throw "workflow: job com nome vazio" }
        if (corpo == null) { throw "workflow '" + nome + "': corpo nulo" }
        this.nome = nome
        this.corpo = corpo
    }

    KofWfJob after(KofWfJob dep) {
        if (dep == null) { throw "workflow '" + nome + "': after() com dependência nula" }
        if (dep.nome == nome) { throw "workflow '" + nome + "': dependência de si mesmo" }
        deps.add(dep)
        return this
    }
}

// face 1/N do bundle 2.1.3 (Q3: helper ADITIVO do próprio workflow): config
// pendurada no job pelo dag; o laço de tentativa mora em run().
class KofWfRetry {
    Int times = 0
    (Int) -> Int backoff = (n: Int) -> 0
}

(Int) -> Int exponential(Int baseMs, Int factor) {
    if (baseMs < 0) { throw "workflow: exponential() com base negativa" }
    if (factor < 1) { throw "workflow: exponential() com fator < 1" }
    return (n: Int) -> {
        var v = baseMs
        var i = 1
        while (i < n) {
            v = v * factor
            i = i + 1
        }
        return v
    }
}

class KofWfReport {
    List<String> succeeded
    List<String> failed
    List<String> skipped
    List<String> errors
    List<String> retries   // "nome: tentativas=N" p/ jobs que retryaram (face 2.1.3)

    public constructor() {
        succeeded = listOf()
        failed = listOf()
        skipped = listOf()
        errors = listOf()
        retries = listOf()
    }

    Bool allOk() {
        return failed.size == 0 && skipped.size == 0
    }

    String summary() {
        return "ok=" + kofWfJoin(succeeded, ",") +
               " failed=" + kofWfJoin(failed, ",") +
               " skipped=" + kofWfJoin(skipped, ",")
    }
}

class KofWfDag {
    List<KofWfJob> jobs

    public constructor(List<KofWfJob> jobs) {
        if (jobs == null) { throw "workflow: dag() sem jobs" }
        if (jobs.size == 0) { throw "workflow: dag() vazia" }
        this.jobs = listOf()
        var i = 0
        while (i < jobs.size) {
            var j = jobs.get(i)
            if (j == null) { throw "workflow: dag() com job nulo" }
            var k = 0
            while (k < this.jobs.size) {
                if (this.jobs.get(k).nome == j.nome) {
                    throw "workflow: nome de job duplicado '" + j.nome + "'"
                }
                k = k + 1
            }
            this.jobs.add(j)
            i = i + 1
        }
    }

    // Q3 (enquete 19/09): retry ADITIVO do workflow — `flow.retry(job, 3,
    // exponential(1000, 2.0))` na forma do sketch §2 (flat); `retryFixed` é a
    // versão imediata. A migração do retry do kof.http sobre este helper é
    // fatia assinada SEPARADA depois (regra 8) — nada aqui toca kof.http.
    KofWfDag retry(KofWfJob j, Int times, (Int) -> Int backoff) {
        if (j == null) { throw "workflow: retry() com job nulo" }
        if (times < 1) { throw "workflow '" + j.nome + "': retry() com times < 1" }
        var alvo = kofWfProcurar(j)
        var cfg = KofWfRetry()
        cfg.times = times
        cfg.backoff = backoff
        alvo.retryCfg = cfg
        return this
    }

    KofWfDag retryFixed(KofWfJob j, Int times) {
        return retry(j, times, (n: Int) -> 0)
    }

    KofWfJob kofWfProcurar(KofWfJob j) {
        var i = 0
        while (i < jobs.size) {
            if (jobs.get(i).nome == j.nome) { return jobs.get(i) }
            i = i + 1
        }
        throw "workflow: retry() em '" + j.nome + "' — job não está na dag"
    }

    // fixpoint sequencial: roda o que está pronto, pula dependentes de
    // falha/skip, e para com erro acionável se uma ronda não progride
    // (ciclo). `done` = nomes concluídos; `bad` = falhou OU foi pulado.
    KofWfReport run() {
        var rep = KofWfReport()
        var rest = listOf()
        var i = 0
        while (i < jobs.size) { rest.add(jobs.get(i)); i = i + 1 }
        var done = listOf()
        var bad = listOf()
        while (rest.size > 0) {
            var progressed = false
            var keep = listOf()
            var j = 0
            while (j < rest.size) {
                var job = rest.get(j)
                var depsOk = true
                var depsBad = false
                var d = 0
                while (d < job.deps.size) {
                    var dn = job.deps.get(d).nome
                    if (kofWfTem(bad, dn)) { depsBad = true }
                    else if (!kofWfTem(done, dn)) { depsOk = false }
                    d = d + 1
                }
                if (depsBad) {
                    rep.skipped.add(job.nome)
                    bad.add(job.nome)
                    progressed = true
                } else if (depsOk) {
                    var corpoFn: () -> Bool = job.corpo
                    var ok = false
                    var erro = ""
                    var tentativa = 0
                    var maxT = 0
                    if (job.retryCfg != null) { maxT = job.retryCfg.times }
                    while (tentativa <= maxT) {
                        try {
                            ok = corpoFn()
                        } catch (String e) {
                            ok = false
                            erro = e
                        }
                        if (ok || tentativa == maxT) { break }
                        tentativa = tentativa + 1
                        erro = ""
                        if (job.retryCfg != null) {
                            var bFn: (Int) -> Int = job.retryCfg.backoff
                            time.sleep(bFn(tentativa))
                        }
                    }
                    if (tentativa > 0) { rep.retries.add(job.nome + ": tentativas=" + (tentativa + 1)) }
                    if (erro != "") { rep.errors.add(job.nome + ": " + erro) }
                    if (ok) {
                        done.add(job.nome)
                        rep.succeeded.add(job.nome)
                    } else {
                        if (erro == "") { rep.errors.add(job.nome + ": false") }
                        bad.add(job.nome)
                        rep.failed.add(job.nome)
                    }
                    progressed = true
                } else {
                    keep.add(job)
                }
                j = j + 1
            }
            if (!progressed) {
                var nomes = listOf()
                var c = 0
                while (c < rest.size) { nomes.add(rest.get(c).nome); c = c + 1 }
                throw "workflow: ciclo detectado entre: " + kofWfJoin(nomes, ",")
            }
            rest = keep
        }
        return rep
    }
}

KofWfJob job(String nome, () -> Bool corpo) {
    return KofWfJob(nome, corpo)
}

KofWfDag dag(List<KofWfJob> jobs) {
    return KofWfDag(jobs)
}
