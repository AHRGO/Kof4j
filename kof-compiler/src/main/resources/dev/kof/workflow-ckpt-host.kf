// dev/kof/workflow-ckpt-host.kf — fatia checkpoint do `kof.workflow`
// (bundle 2.1.3), injetada em NÃO-Native. Plano §5/Q4: o store do checkpoint
// REUSA kof.db/kof.orm — nunca um subsistema novo. O host-core NUNCA
// referencia kof.orm (gate ORM001 é estático: derrubaria o host INTEIRO no
// Native — mesmo mecanismo do CRON001 do schedule, medido); esta fatia injeta
// `checkpoint(d, dbConn, dagName)`, que abre a conexão, cria a tabela da
// entidade `KofWfCk` (IF NOT EXISTS — idempotente) e registra os hooks
// ckLoad/ckSave na dag via `ckHooks`:
//   • ckLoad: `orm.where` por "dagName/jobName" — job restaurado entra como
//     succeeded e NÃO re-executa;
//   • ckSave: `orm.save` pós-sucesso (a chave unique garante 1 linha por
//     job; a recusa/throw falha ALTO com o nome do job — R6).
// A conexão vive presa nos closures da dag (sem close automático — para H2
// mem use DB_CLOSE_DELAY=-1 e feche no seu corpo se precisar). Native entra
// com o stub workflow-ckpt-host.native.kf (ORM001 em runtime, R6).
//
// Injetada por CompilerWorkflow no `import kof.workflow` (DD-OTP-01 opção A).

entity KofWfCk {
    id: Long generated
    key: String unique
}

KofWfDag checkpoint(KofWfDag d, String dbConn, String dagName) {
    if (d == null) { throw "workflow: checkpoint() com dag nula" }
    if (dbConn == null || dbConn == "") { throw "workflow: checkpoint() sem conexão db" }
    if (dagName == null || dagName == "") { throw "workflow: checkpoint() sem nome de dag" }
    var db = db.connect(dbConn)
    orm.create<KofWfCk>(db)
    var prefix = dagName + "/"
    d.ckHooks(
        dagName,
        (dag: String, jobName: String) -> {
            var found = orm.where<KofWfCk>(db, "key", dag + "/" + jobName)
            return found.size > 0
        },
        (dag: String, jobName: String) -> {
            orm.save(db, KofWfCk(0, dag + "/" + jobName))
            return true
        }
    )
    return d
}
