#!/bin/bash
# Pre-commit guard do Kof4j (PACTO DE AGREGAÇÃO, 14/09 — ordem da mantenedora).
# Barato (<2s) e sem falso-positivo: só impede commit QUEBRADO.
# Bypass em emergência: git commit --no-verify (e registre o motivo no DOING.md).
set -u

# 1. Marcadores de conflito e erros de whitespace no que está staged.
#    (Precedente: rebase entre lanes commitou `<<<<<<<` no DOING em 14/09.)
if ! git diff --cached --check --; then
    echo "pre-commit: marcadores de conflito / whitespace errors no staged. Resolva e tente de novo." >&2
    exit 1
fi

exit 0
