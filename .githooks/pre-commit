#!/usr/bin/env bash
#
# pre-commit — documentacao bilingue: reaplica/restaura o idioma da maquina.
# No-op durante rebase/merge/cherry-pick (mexer na arvore ali quebra o git).
root="$(git rev-parse --show-toplevel 2>/dev/null)" || exit 0
[ -x "$root/scripts/docs-lang.sh" ] || exit 0
for marker in rebase-merge rebase-apply MERGE_HEAD CHERRY_PICK_HEAD REVERT_HEAD; do
    [ -e "$root/.git/$marker" ] && exit 0
done
"$root/scripts/docs-lang.sh" restore >/dev/null 2>&1 || true
# PACTO DE AGREGAÇÃO (14/09, ordem da mantenedora): bloqueia commit com
# marcador de conflito / whitespace error no staged (precedente 14/09:
# rebase entre lanes commitou `<<<<<<<`). Bypass: --no-verify + motivo no DOING.
if ! git diff --cached --check --; then
    echo "pre-commit: marcadores de conflito / whitespace errors no staged. Resolva e tente de novo." >&2
    exit 1
fi
exit 0
